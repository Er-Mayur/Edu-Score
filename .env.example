# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Settings
DB_ENGINE=django.db.backends.mysql
DB_NAME=eduscore_db
DB_USER=root
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306

# Google Apps Script Integration
# The Deployment URL of your Apps Script Web App
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# The secret token verified in the Apps Script (doPost/doGet)
APPS_SCRIPT_TOKEN=EDUSCORE_SECRET

# The Google Sheet URL where results will be stored
APPS_SCRIPT_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/